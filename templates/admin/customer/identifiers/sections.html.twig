{% set form = hookable_metadata.context.form %}

{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

<div class="page-body">
    <div class="container-xl">
        {{ form_start(form, {'attr': {'id': 'tmonier-facturx-customer-identifiers', 'novalidate': 'novalidate'}}) }}
        {{ form_errors(form) }}
        <div class="card">
            <div class="card-body">
                <p class="text-secondary">{{ 'tmonier_facturx.ui.customer_identifiers_help'|trans }}</p>
                {{ form_row(form.companyName) }}
                {{ form_row(form.siren) }}
                {{ form_row(form.vatNumber) }}
                {{ form_row(form.electronicAddress) }}
                {{ form_row(form.electronicAddressScheme) }}
            </div>
        </div>
        {{ form_end(form, {render_rest: true}) }}
    </div>
</div>
