<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusFacturXPlugin\Entity\CustomerIdentifiers" table="tmonier_facturx_customer_identifiers">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="companyName" column="company_name" type="string" length="255" nullable="true" />
        <field name="siren" column="siren" type="string" length="9" nullable="true" />
        <field name="vatNumber" column="vat_number" type="string" length="32" nullable="true" />
        <field name="electronicAddress" column="electronic_address" type="string" length="255" nullable="true" />
        <field name="electronicAddressScheme" column="electronic_address_scheme" type="string" length="8" nullable="true" />

        <one-to-one field="customer" target-entity="Sylius\Component\Core\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="false" unique="true" on-delete="CASCADE" />
        </one-to-one>
    </mapped-superclass>

</doctrine-mapping>
